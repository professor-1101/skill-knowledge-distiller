# Other agents' configuration directories. This repository's skill lives in
# .cline/skills/ and is committed deliberately, so a team shares it through
# git. Anything an unrelated tool drops at the root is that tool's local state
# and is nobody else's business.
.claude/
.claude/skills/

# Node
node_modules/
npm-debug.log*

# Generated by the skill's own installers. Regenerated on demand, and a
# committed copy would go stale against the scripts that write it.
.clinerules/hooks/
.cline/hooks/

# Working output of a distillation run. The claim store belongs in whatever
# repository holds the book being distilled, not in the methodology's own.
reports/
*.epub

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
